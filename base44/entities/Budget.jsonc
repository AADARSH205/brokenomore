{
  "name": "Budget",
  "type": "object",
  "properties": {
    "month": {
      "type": "string",
      "description": "Month this limit applies to, YYYY-MM"
    },
    "category": {
      "type": "string",
      "enum": [
        "food",
        "groceries",
        "rent",
        "transport",
        "shopping",
        "entertainment",
        "travel",
        "bills",
        "medical",
        "education",
        "emi",
        "subscriptions",
        "other"
      ],
      "enumColors": [
        "yellow",
        "yellow",
        "purple",
        "blue",
        "pink",
        "red",
        "green",
        "gray",
        "red",
        "blue",
        "purple",
        "purple",
        "gray"
      ],
      "description": "Spending category this limit covers"
    },
    "limit_amount": {
      "type": "number",
      "description": "Spending limit for the month, in rupees"
    }
  },
  "required": [
    "month",
    "category",
    "limit_amount"
  ],
  "rls": {
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}