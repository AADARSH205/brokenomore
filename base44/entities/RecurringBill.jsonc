{
  "name": "RecurringBill",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "What the bill is for, such as Rent or Electricity"
    },
    "amount": {
      "type": "number",
      "description": "Usual amount due each month, in rupees"
    },
    "category": {
      "type": "string",
      "enum": [
        "food",
        "groceries",
        "rent",
        "transport",
        "shopping",
        "entertainment",
        "travel",
        "bills",
        "medical",
        "education",
        "emi",
        "subscriptions",
        "other"
      ],
      "enumColors": [
        "yellow",
        "yellow",
        "purple",
        "blue",
        "pink",
        "red",
        "green",
        "gray",
        "red",
        "blue",
        "purple",
        "purple",
        "gray"
      ],
      "description": "Category this bill is counted under"
    },
    "due_day": {
      "type": "integer",
      "description": "Day of the month the bill is due, 1 to 31"
    },
    "is_essential": {
      "type": "boolean",
      "default": true,
      "description": "Essential bills are held back from the daily number until paid"
    },
    "active": {
      "type": "boolean",
      "default": true,
      "description": "Whether this bill still applies"
    }
  },
  "required": [
    "name",
    "amount",
    "due_day"
  ],
  "rls": {
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}